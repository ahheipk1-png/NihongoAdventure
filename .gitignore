# Clips Workers AI returned silent or malformed. Kept on disk as evidence and
# to keep them out of audio/ so a later run regenerates them - worthless in the
# repo. audio_small/ IS tracked: audio/ is ignored, so those vetted mp3s are the
# only durable copy of clips that cost real neurons.
audio-build/audio_rejected/
__pycache__/
audio-build/dist/
audio-build/local_wav/
audio-build/local_trimmed/
audio-build/sample_out/
audio-build/local_probe/
audio-build/voice-sample.wav
audio-build/probe*.json
.kq-bk-*.html

# Scratch from the Nanami voice work. edge_mp3/ and the two kana style folders
